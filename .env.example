# MXR CLIP ENGINE settings. Copy to .env and edit. Everything is optional.

# Speech-to-text (runs locally, free). Sizes: tiny, base, small, medium, large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=int8
# 1 = fastest (greedy). 5 = most careful, roughly 2-3x slower on a CPU.
WHISPER_BEAM_SIZE=1
# CPU threads for transcription. Leave blank to use every core.
WHISPER_THREADS=

# AI ranking (optional). Any OpenAI-compatible endpoint works:
# OpenAI, OpenRouter, Groq, Ollama, vLLM, and others.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# How many moments the AI reviews before picking the best (more = better picks, higher cost)
LLM_SHORTLIST=36

# Highest source resolution to download from links
MAX_DOWNLOAD_HEIGHT=1080

# Where projects and clips are stored
CLIPPER_DATA_DIR=./data

# Server. Use HOST=0.0.0.0 to reach the app from other devices on your network.
PORT=8000
HOST=127.0.0.1
NO_BROWSER=
